# Copy to .env.daily and fill in to enable email delivery of the daily report.
# .env.daily is read only by scripts/daily_cron.sh — keep it out of any VCS.

# Where the report goes:
DAILY_EMAIL_TO=jtarman@hotmail.com

# SMTP credentials (most providers require an app password, not your login password):
OPTIONSTRADER_SMTP_HOST=smtp-mail.outlook.com
OPTIONSTRADER_SMTP_PORT=587
OPTIONSTRADER_SMTP_USER=you@example.com
OPTIONSTRADER_SMTP_PASSWORD=your-app-password
# OPTIONSTRADER_SMTP_FROM=you@example.com   # optional, defaults to SMTP_USER
